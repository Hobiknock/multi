# ============================================
# KINTARA BOT (RY GROUP) + PATCH metode kita
# ============================================

# Private key wallet Kintara kamu (base58 Solana, 64 byte) — single wallet
WALLET_PRIVATE_KEY=IsiPrivateKeyBase58KamuDisini

# Token bot Telegram (chat @BotFather -> /newbot -> copy token)
TELEGRAM_BOT_TOKEN=123456:IsiTokenBotFatherDisini

# OPSIONAL — biarkan kosong kalau gak tau:
# TELEGRAM_CHAT_ID=        # auto-terekam saat kamu kirim command pertama
# KINTARA_FORCE_SERVER=    # paksa server, contoh: 15

# ---- PATCH: MULTI-WALLET (1 pk per baris, blok ditutup baris kosong) ----
# Kalau diisi, WALLET_PRIVATE_KEY di atas diabaikan dan tiap wallet jalan paralel.
WALLETS=

# ---- PATCH: SHARD untuk rotasi saat zona steril (node beda per shard) ----
KINTARA_SERVERS=s1,s2,s3,s4

# ---- PATCH: PROXY anti-flag (1 proxy per baris = 1 per wallet) ----
# Kosongkan kalau gak pakai. Contoh Cloudflare WARP:
#   socks5://127.0.0.1:40000
#   socks5://127.0.0.1:40001
KINTARA_PROXIES=

# (fallback) satu proxy untuk semua wallet
KINTARA_PROXY=

# ---- PATCH: auto-bank ke Bank Mainland kalau stone/coal >= nilai ini ----
AUTO_BANK_MIN=10000

# ---- PATCH: KINS itu Token-2022 (bukan token klasik) ----
KINS_MINT=Tqj8yFmagrg7oorpQkVGYR52r96RFTamvWfth9bpump
SOLANA_RPC=https://api.mainnet-beta.solana.com
